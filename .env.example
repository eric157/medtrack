# MedTrack Environment Variables

## Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

## Site URL (required for auth redirects & Google OAuth)
NEXT_PUBLIC_SITE_URL=https://medtrack-flame.vercel.app

## Kiosk PIN (default: 1234)
KIOSK_PIN=1234

## Google OAuth (Tasks API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:caregiver@example.com

## Vercel Cron protection
CRON_SECRET=your-random-secret

## Optional fallback for Google Tasks without OAuth
GOOGLE_ACCESS_TOKEN=
