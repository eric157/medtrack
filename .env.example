# MedTrack Environment Variables (copy to .env.local or Vercel)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (required for auth redirects & Google OAuth)
NEXT_PUBLIC_SITE_URL=https://medtrack-flame.vercel.app

# Timezone for dose windows & missed-dose detection (IANA name)
NEXT_PUBLIC_MEDTRACK_TIMEZONE=America/New_York

# Kiosk PIN (default: 1234)
KIOSK_PIN=1234

# Web Push (run npm run setup to generate)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:caregiver@medtrack.app

# Vercel Cron protection (run npm run setup to generate)
CRON_SECRET=

# Google OAuth — optional, for Tasks sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
